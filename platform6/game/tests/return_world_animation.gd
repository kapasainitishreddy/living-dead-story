extends SceneTree
var checks := 0
var failures := 0
func check(ok: bool, message: String):
	checks += 1
	if not ok:
		failures += 1
		printerr("FAIL: " + message)
func _initialize(): call_deferred("run")
func state(checkpoint := "farewell") -> Dictionary:
	return {"return_checkpoint":checkpoint,"return_state":{"farewell":"thanks","completed":false},"settings":{"reduced_motion":false}}
func run():
	check(ResourceLoader.exists("res://world/return_world.gd"),"return animated world exists")
	if failures: quit(1); return
	var world = load("res://world/return_world.gd").new().build(state())
	root.add_child(world)
	await process_frame
	world.set_process(false)
	var preparation_count = [0]
	var departure_count = [0]
	world.preparation_finished.connect(func(): preparation_count[0] += 1)
	world.departure_finished.connect(func(): departure_count[0] += 1)
	world.begin_preparation()
	check(world.preparation_active and world.cinematic_phase == "notice","Mira first notices changed indicator")
	check(world.get_node("Indicator/Destination").text.contains("LOWER MILL"),"indicator visibly changes destination")
	world._process(0.75)
	var mira = world.get_node("Mira")
	check(mira.rotation.y < -0.6,"Mira visibly turns toward changed departure indicator")
	world._process(0.25)
	var hand = mira._bone_index("UpperArmLeft")
	var arm_before = mira.skeleton.get_bone_pose_rotation(hand)
	world._process(1.7)
	check(world.cinematic_phase == "lift_tool_roll","Mira bends and lifts before touching the strap")
	check(mira.skeleton.get_bone_pose_rotation(hand) != arm_before,"lift is skeletal performance rather than a caption")
	check(world.get_node("ToolRoll").position.y > 0.7,"tool roll physically rises in Mira's hand")
	world._process(1.7)
	check(world.cinematic_phase == "adjust_strap","Mira adjusts strap after lifting tools")
	world._process(1.6)
	check(preparation_count[0] == 1 and world.cinematic_phase == "farewell","preparation ends facing player once")
	check(world.get_node("ToolRoll").position.y > 0.65,"farewell holds carried tools above floor")
	world.begin_departure("thanks","lend")
	check(world.departure_active and world.cinematic_phase == "farewell_reply","chosen farewell receives live acknowledgement")
	world._process(1.4)
	check(world.cinematic_phase == "approach","train follows acknowledgement in every farewell")
	check(world.get_node("Train").visible,"approaching train is physically rendered")
	var start_z = world.get_node("Train").position.z
	world._process(2.0)
	check(world.get_node("Train").position.z > start_z,"train approaches along real tracks")
	check(world.cinematic_state().air_shift > 0.0,"approach shifts air through coat and hair")
	world._process(3.0)
	check(world.cinematic_phase == "doors_open" and world.cinematic_state().door_open > 0.0,"doors visibly open before boarding")
	world._process(2.8)
	check(world.cinematic_phase == "boarding" and mira.position.x > 2.5,"Mira physically walks toward open doorway")
	world._process(2.6)
	check(world.cinematic_phase == "turn_back" and mira.position.x > 5.0,"Mira boards then turns back")
	var left_grip = mira.skeleton.global_transform * mira.skeleton.get_bone_global_pose(mira._bone_index("HandLeft")).origin
	check(world.get_node("ToolRoll").global_position.distance_to(left_grip-Vector3(0,0.12,0)) < 0.06,"carried tool-roll loop is aligned with Mira's actual left hand")
	var shot = world.get_node("ReturnCamera")
	var sight_start = Vector2(shot.position.x,shot.position.z)
	var sight_end = Vector2(mira.position.x,mira.position.z)
	for pillar in world.get_node("StationArt").get_children():
		if pillar is StaticBody3D and (pillar.name.begins_with("CanopyColumn") or (pillar.position.x > 3.7 and pillar.position.y > 2.6 and pillar.position.y < 2.8)):
			var position_ = Vector2(pillar.position.x,pillar.position.z)
			var nearest = Geometry2D.get_closest_point_to_segment(position_,sight_start,sight_end)
			check(position_.distance_to(nearest) > 0.3,"turn-back portrait is not hidden by canopy column " + str(pillar.name))
	world._process(1.8)
	check(world.cinematic_phase == "camera_slip" and world.cinematic_state().camera_slip > 0.0,"carried camera slips before she catches it")
	world._process(1.1)
	check(world.cinematic_state().camera_caught and world.cinematic_state().laughing,"Mira catches camera and physically laughs")
	var portrait = world.get_node("ReturnCamera")
	check(portrait.position.distance_to(mira.position+Vector3(0,1.2,0)) < 4.1 and float(portrait.get_meta("fov")) < 41.0,"camera catch receives a stable readable portrait framing")
	world._process(2.2)
	check(world.cinematic_phase == "doors_close" and world.cinematic_state().door_open < 1.0,"doors close after Mira's turn and laugh")
	world._process(3.5)
	check(world.cinematic_phase == "train_leaves" and world.get_node("Train").position.z > 2.0,"train physically leaves after doors close")
	world._process(3.5)
	check(world.cinematic_phase == "ambience_hold" and departure_count[0] == 0,"departure holds empty platform with no automatic dialogue")
	check(not world.get_node("Mira").visible,"Mira leaves with train")
	world._process(3.0)
	check(departure_count[0] == 0,"empty platform hold is several seconds")
	world._process(1.5)
	check(departure_count[0] == 1 and world.cinematic_phase == "settled","ambience hold resolves once")
	check(world.snapshot.return_state.farewell == "thanks","animation never rewrites saved choices")
	world.begin_departure("wave","take")
	world._process(11.5)
	check(world.cinematic_phase == "turn_back" and not world.cinematic_state().camera_with_mira,"protagonist camera branch omits camera catch")
	check(not world.get_node("CameraLeftBehind").visible,"protagonist-owned camera is not abandoned at station")
	world.finish_departure()
	check(departure_count[0] == 2 and not world.departure_active,"skip settles every departure branch immediately")
	world.finish_departure()
	check(departure_count[0] == 2,"repeated skip cannot complete twice")
	world.begin_preparation()
	world.set_paused(true)
	var camera_pose = world.get_node("ReturnCamera").transform
	var actor_pose = mira.skeleton.get_bone_pose_rotation(hand)
	world._process(30.0)
	check(preparation_count[0] == 1 and world.get_node("ReturnCamera").transform == camera_pose and mira.skeleton.get_bone_pose_rotation(hand) == actor_pose,"pause freezes preparation camera and actor")
	world.set_reduced_motion(true)
	check(preparation_count[0] == 1 and mira.skeleton.get_bone_pose_rotation(hand) == actor_pose,"reduced toggle respects frozen acting in an open pause")
	world.set_paused(false)
	check(preparation_count[0] == 2 and not world.preparation_active,"resume settles reduced-motion preparation without forced wait")
	world.begin_departure("little","lend")
	check(departure_count[0] == 3 and not world.departure_active,"reduced-motion departure settles functionally immediately")
	world.set_reduced_motion(false)
	world.begin_departure("luck","lend")
	world._process(2.0)
	world.set_paused(true)
	var train_pose = world.get_node("Train").transform
	var elapsed = world.departure_elapsed
	world._process(60.0)
	check(world.get_node("Train").transform == train_pose and world.departure_elapsed == elapsed,"pause freezes train and departure clock")
	world.finish_departure()
	check(departure_count[0] == 4 and world.cinematic_phase == "settled","skip remains available while paused")
	world.free()
	print("Return animation checks: %d; failures: %d" % [checks,failures])
	quit(1 if failures else 0)
